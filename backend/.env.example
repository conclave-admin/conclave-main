NODE_ENV=development
PORT=7000
CLIENT_ORIGIN=http://localhost:5173
# Exact comma-separated browser origins for the public and operator hosts.
# CLIENT_ORIGIN remains the compatibility fallback when this is unset.
CLIENT_ORIGINS=http://localhost:5173,http://admin.localhost:5173
# Production Render values (replace the localhost origins above):
# CLIENT_ORIGIN=https://conclave.com.ng
# CLIENT_ORIGINS=https://conclave.com.ng,https://admin.conclave.com.ng
# Number of trusted reverse-proxy hops in front of Express. Use 1 for the
# intended single Render/Vercel-facing proxy; keep 0 for direct local access.
TRUST_PROXY_HOPS=0

Team lifecycle tests

# PostgreSQL
DATABASE_URL=postgres://app:app@localhost:5432/platform_dev
# Production: postgres://<db-user>:<db-password>@<db-host>:<port>/<db-name>

# Redis is optional. Production rate limits use PostgreSQL if Redis is absent.
REDIS_URL=
# Production Render Redis URL: rediss://<user>:<password>@<redis-host>:<port>
RATE_LIMIT_KEY_PREFIX=rate-limit
SOCKET_REDIS_ADAPTER=false

# Controlled beta capacity and storage monitoring. Registration is open until
# disabled or the active-account cap is reached. Storage estimates omit egress
# and request/operation charges; use the provider billing console for actuals.
BETA_SIGNUPS_ENABLED=true
BETA_MAX_ACTIVE_ACCOUNTS=250
BETA_MAX_TEAM_MEMBERS=25
BETA_STORAGE_ALERT_GB=50
BETA_STORAGE_USD_PER_GB_MONTH=0
BETA_STORAGE_MONTHLY_BUDGET_USD=0

# JWT
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
# Replace both examples with independent random secrets in Render.
# Generate each with: openssl rand -base64 48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Account verification/recovery mail, sent through the Resend API.
RESEND_API_KEY=
# Put your Resend API key (starts with re_) in local .env or Render secrets.
# Full sender email on a domain verified in Resend, for example:
# RESEND_FROM="Conclave <verify@conclave.com.ng>"
RESEND_FROM=
# Public frontend origin used in emailed links; defaults to CLIENT_ORIGIN.
APP_PUBLIC_URL=http://localhost:5173
# Production: APP_PUBLIC_URL=https://conclave.com.ng
# 32 random bytes encoded as base64url; protects token-bearing queued mail.
MAIL_ENCRYPTION_KEY=
# Generate locally with: openssl rand -base64 32

# Browser Web Push. Generate a stable pair with web-push; never expose the private key.
# VAPID_SUBJECT must be a real public mailto: contact or HTTPS contact URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional comma-separated exact HTTPS push-service origins beyond built-in providers.
PUSH_ALLOWED_ORIGINS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT is optional when R2_ACCOUNT_ID is set.
R2_BUCKET=conclave-uploads
R2_ENDPOINT=
R2_PREVIEW_WORKER_URL=
R2_PREVIEW_SIGNING_SECRET=

# Enable only after applying the reviewed bucket CORS configuration.
R2_DIRECT_UPLOADS_ENABLED=false
# Comma-separated exact browser origins; defaults to CLIENT_ORIGIN.
R2_ALLOWED_ORIGINS=
MEDIA_CLEANUP_INTERVAL_MS=300000

# One-to-one voice calls use WebRTC. STUN-only works on some networks;
# configure TURN with a shared secret for reliable NAT/firewall relay.
RTC_STUN_URLS=stun:stun.l.google.com:19302
RTC_TURN_URLS=
RTC_TURN_SHARED_SECRET=
