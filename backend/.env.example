NODE_ENV=development
PORT=7000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://app:app@localhost:5432/platform_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Account verification/recovery mail, sent through the Resend API.
RESEND_API_KEY=
# Full sender email on a domain verified in Resend, for example:
# RESEND_FROM="Conclave <sender@example.com>"
RESEND_FROM=
# Public frontend origin used in emailed links; defaults to CLIENT_ORIGIN.
APP_PUBLIC_URL=
# 32 random bytes encoded as base64url; protects token-bearing queued mail.
MAIL_ENCRYPTION_KEY=

# Browser Web Push. Generate a stable pair with web-push; never expose the private key.
# VAPID_SUBJECT must be a real public mailto: contact or HTTPS contact URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional comma-separated exact HTTPS push-service origins beyond built-in providers.
PUSH_ALLOWED_ORIGINS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT is optional when R2_ACCOUNT_ID is set.
R2_BUCKET=conclave-uploads
R2_ENDPOINT=
R2_PREVIEW_WORKER_URL=
R2_PREVIEW_SIGNING_SECRET=

# Enable only after applying the reviewed bucket CORS configuration.
R2_DIRECT_UPLOADS_ENABLED=false
# Comma-separated exact browser origins; defaults to CLIENT_ORIGIN.
R2_ALLOWED_ORIGINS=
MEDIA_CLEANUP_INTERVAL_MS=300000
