{
  "name": "platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node database/migrate.js",
    "migrate:baseline": "node database/migrate.js --baseline",
    "seed": "node database/seed.js",
    "test": "node --test test/*.test.js",
    "test:db": "node --test tests/*.test.js",
    "test:integration": "npm run test:db",
    "media:cleanup": "node scripts/media-cleanup.js",
    "storage:configure": "node scripts/storage-configure.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "file-type": "^22.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pg": "^8.12.0",
    "redis": "^4.7.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
