VITE_API_URL=http://localhost:7000/api
VITE_SOCKET_URL=http://localhost:7000
# Production Vercel values:
# VITE_API_URL=https://<your-render-service>.onrender.com/api
# VITE_SOCKET_URL=https://<your-render-service>.onrender.com

# Hostname which renders the private operator console. Configure this value
# identically for public and operator Vercel domains.
VITE_OPERATOR_HOST=admin.localhost
VITE_OPERATOR_URL=http://admin.localhost:5173
# Production Vercel values:
# VITE_OPERATOR_HOST=admin.conclave.com.ng
# VITE_OPERATOR_URL=https://admin.conclave.com.ng

# Local UI preview only. Never enabled in production builds because the code
# also requires import.meta.env.DEV. Set true in .env.local to bypass auth.
VITE_DEV_AUTH_BYPASS=false

# Voice/video calling stays hidden until its beta acceptance is complete.
VITE_CALLS_ENABLED=false
